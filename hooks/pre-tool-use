#!/usr/bin/env bash
# DevFlow PreToolUse hook — Branch Protection Gate
# Blocks Edit/Write on protected branches.
# Allows workflow files (handoff, checkpoints, plans, .context/workflow/).
# On block: instructs LLM to invoke devflow:git-strategy automatically.
#
# Config source: .context/.devflow.yaml (generated by /devflow config)
# If config is missing, blocks with MSG_NO_CONFIG instruction.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# --- Load i18n ---

source "${SCRIPT_DIR}/i18n.sh"
load_i18n

# --- Read stdin (Claude Code passes tool context as JSON) ---

INPUT=$(cat)

# --- Saída única do hook (P0, ADR-015) ---
# Todo JSON que este hook imprime sai daqui. A razão chega crua (pode ter C0, aspas,
# barras, bidi) e o json.dumps do Python serializa. Texto fora do JSON anula a decisão
# (hooks.md), por isso nada mais escreve no stdout.
ADDL_CTX=""
ADDL_IDS=""
SESSION_KEY=""
DECIDED=0
# Razão de um `ask` da catraca de standards (T16), emitido só na saída: um deny posterior
# (branch protegida, config-guard) prevalece sobre ele.
STDGUARD_PENDING=""
emit_decision() {
  local decision="$1" reason="${2:-}" out=""
  DECIDED=1
  out=$(printf '%s' "$ADDL_CTX" | DEVFLOW_DECISION="$decision" DEVFLOW_REASON="$reason" python3 -c '
import json, os, sys
MAX = 9000  # em unidades UTF-16: é assim que o Claude Code mede o campo
def u16(s):
    return len(s.encode("utf-16-le", "surrogatepass")) // 2
ctx = sys.stdin.buffer.read().decode("utf-8", "replace")
if u16(ctx) > MAX:
    note = "\n…(contexto truncado no limite de 9000 caracteres; leia os arquivos citados)"
    # Corta em unidades UTF-16; "ignore" descarta a metade alta órfã de um par partido.
    head = ctx.encode("utf-16-le", "surrogatepass")[: 2 * (MAX - u16(note))]
    ctx = head.decode("utf-16-le", "ignore") + note
h = {"hookEventName": "PreToolUse"}
d = os.environ.get("DEVFLOW_DECISION", "")
if d in ("deny", "ask"):
    h["permissionDecision"] = d
    h["permissionDecisionReason"] = os.environ.get("DEVFLOW_REASON", "")
if ctx:
    h["additionalContext"] = ctx
if len(h) > 1:
    print(json.dumps({"hookSpecificOutput": h}))
' 2>/dev/null) || out=""
  if [ -z "$out" ] && { [ "$decision" = "deny" ] || [ "$decision" = "ask" ]; }; then
    out="{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"${decision}\",\"permissionDecisionReason\":\"[devflow] decisao sem detalhe (falha ao serializar a razao)\"}}"
  fi
  if [ -n "$out" ]; then printf '%s\n' "$out"; fi
  # Allow com contexto já ESCRITO: só agora marca os ids como injetados (em deny/ask a
  # entrega não é garantida e o contexto volta na próxima edição). Sem session_id (chave
  # ":…") não há cache. Saída descartada: nada além do JSON sai do hook.
  if [ "$decision" = "context" ] && [ -n "$out" ] && [ -n "${ADDL_IDS:-}" ] \
     && [ -n "${SESSION_KEY:-}" ] && [ "${SESSION_KEY#:}" = "$SESSION_KEY" ]; then
    node "${PLUGIN_ROOT}/scripts/lib/pre-edit-context.mjs" --mark "${PROJECT_ROOT:-${CWD:-$PWD}}" "${SESSION_KEY}" "${ADDL_IDS}" >/dev/null 2>&1 || true
  fi
  exit 0
}
# Caminho de allow (nenhuma decisão emitida): entrega o contexto; a marcação no cache
# acontece dentro de emit_decision, depois de a saída ter sido escrita. Um ask pendente da
# catraca (T16) vira a decisão aqui — também quando o hook sai por erro depois do guard.
flush_context() {
  if [ "$DECIDED" = "0" ] && [ -n "$STDGUARD_PENDING" ]; then emit_decision ask "$STDGUARD_PENDING"; fi
  if [ "$DECIDED" = "0" ] && [ -n "$ADDL_CTX" ]; then emit_decision context ""; fi
}
trap flush_context EXIT

TOOL_NAME=$(printf '%s' "$INPUT" | python3 -c "
import json, sys
d = json.load(sys.stdin)
print(d.get('tool_name', ''))
" 2>/dev/null || echo "")

CWD=$(printf '%s' "$INPUT" | python3 -c "
import json, sys
d = json.load(sys.stdin)
print(d.get('cwd', ''))
" 2>/dev/null || echo "")

# --- Permissions evaluator (Task 3.2, SI compliance — runs FIRST) ---
# Loads .context/permissions.yaml and evaluates deny → allow → mode → callback.
# A 'deny' decision exits the hook immediately (deny via emit_decision);
# 'allow' continues to existing branch protection (defense-in-depth);
# 'prompt' falls through to the legacy logic.
#
# ADV-7: the evaluator ALWAYS runs — even without a permissions.yaml — so the
# baseline default-deny of secrets (loadPermissions returns it when the file is
# absent) is enforced. Cost: 1 node process per tool-call in projects without a
# permissions.yaml (accepted trade-off; secrets protection is not opt-in).
#
# Uses event.cwd (not PWD) so the hook reads the permissions.yaml of the
# user's project, not the plugin install dir.

PERMS_DIR="${CWD:-$PWD}"
if true; then  # ADV-7: sempre avaliar (baseline default-deny vale sem permissions.yaml)
  EVENT_PATH=$(printf '%s' "$INPUT" | python3 -c "
import json, sys
d = json.load(sys.stdin)
ti = d.get('tool_input', {})
print(ti.get('file_path') or ti.get('file') or ti.get('path') or '')
" 2>/dev/null || echo "")

  EVENT_CMD=$(printf '%s' "$INPUT" | python3 -c "
import json, sys
d = json.load(sys.stdin)
ti = d.get('tool_input', {})
print(ti.get('command', ''))
" 2>/dev/null || echo "")

  PERM_INPUT=$(printf '%s' "$INPUT" | python3 -c "
import json, sys
d = json.load(sys.stdin)
ti = d.get('tool_input', {})
ev = {
    'tool': d.get('tool_name', ''),
    'path': ti.get('file_path') or ti.get('file') or ti.get('path') or None,
    'command': ti.get('command', '') or None,
}
print(json.dumps(ev))
" 2>/dev/null || echo "{}")

  # Run the CLI with cwd set to the user's project so permissions-evaluator
  # loads the correct .context/permissions.yaml.
  PERM_OUT=$(printf '%s' "$PERM_INPUT" | (cd "${PERMS_DIR}" && node "${PLUGIN_ROOT}/scripts/lib/permissions-cli.mjs") 2>/dev/null || echo "")

  if [ -n "$PERM_OUT" ]; then
    PERM_DECISION=$(printf '%s' "$PERM_OUT" | python3 -c "
import json, sys
try: print(json.load(sys.stdin).get('decision', ''))
except: print('')
" 2>/dev/null || echo "")

    if [ "$PERM_DECISION" = "deny" ]; then
      PERM_REASON=$(printf '%s' "$PERM_OUT" | python3 -c "
import json, sys
try:
    reason = json.load(sys.stdin).get('reason', 'permissions.yaml denied')
except Exception:
    reason = 'permissions.yaml denied'
print(f'[devflow permissions.yaml] {reason}')
" 2>/dev/null || echo "[devflow permissions.yaml] denied")
      # OTel antes da decisão e sem stdout: nada além do JSON pode sair do hook.
      if [ -f "${PERMS_DIR}/.context/observability.yaml" ]; then
        printf '{"event":"devflow.permission.deny","attributes":{"devflow.permission.decision":"deny","gen_ai.tool.name":"%s"}}' "$TOOL_NAME" \
          | (cd "${PERMS_DIR}" && node "${PLUGIN_ROOT}/scripts/lib/otel-cli.mjs") >/dev/null 2>&1 || true
      fi
      emit_decision deny "$PERM_REASON"
      exit 0
    fi
  fi
fi

# --- Grounding mode: block internet tools when doc-grounding is active ---
# Self-contained, web-tool-only branch placed BEFORE the Edit/Write gate so it
# can act on WebSearch/WebFetch (which the gate below exits 0 on). It NEVER
# touches the branch-protection path (that runs only for Edit/Write). Grounding
# absent/off → no-op (opt-in). Fail-open on parse error (does not block).
case "$TOOL_NAME" in
  WebSearch|WebFetch)
    GROUNDING_CONFIG="${CWD:-$PWD}/.context/.devflow.yaml"
    if [ -f "$GROUNDING_CONFIG" ]; then
      GROUNDING_REASON=$(python3 - "$GROUNDING_CONFIG" "$TOOL_NAME" << 'PYEOF'
import sys, json
fp, tool = sys.argv[1], sys.argv[2]
mode, block_web, server = 'off', True, 'docs-mcp-server'
try:
    in_g = False
    for raw in open(fp):
        line = raw.rstrip('\n')
        stripped = line.strip()
        if stripped == 'grounding:':
            in_g = True
            continue
        if in_g:
            # leave the section at the first non-indented, non-empty line
            if line and not line[0].isspace():
                break
            if stripped.startswith('mode:'):
                mode = stripped.split(':', 1)[1].strip().strip('"\'')
            elif stripped.startswith('blockWeb:'):
                block_web = stripped.split(':', 1)[1].strip().lower() != 'false'
            elif stripped.startswith('docsMcpServer:'):
                server = stripped.split(':', 1)[1].strip().strip('"\'')
except Exception:
    sys.exit(0)  # fail-open: never block on parse error (grounding is opt-in)
if mode != 'off' and block_web:
    reason = ("[devflow grounding:%s] Ferramenta de internet '%s' bloqueada — o modo "
              "doc-grounding exige que fatos de stack (lib/framework/API/versão) venham "
              "SÓ do MCP de documentação. Use mcp__%s__search_docs / find_version. Se a "
              "doc não estiver indexada, rode /devflow:scrape-stack-batch ou declare a "
              "incerteza — NUNCA responda de memória de treino." % (mode, tool, server))
    print(reason)  # cru: emit_decision serializa
PYEOF
)
      if [ -n "$GROUNDING_REASON" ]; then
        emit_decision deny "$GROUNDING_REASON"
        exit 0
      fi
    fi
    ;;
esac

# --- ADV-6: guard destructive git ops on protected branches ---
# git push / gh pr merge / git commit run DIRECTLY on a protected branch must go
# through PREVC phase C / devflow:git-strategy — this closes the gap that the
# Edit/Write gate (below) leaves open for Bash. Self-contained; a cheap `case`
# pre-filter means the node guard only runs for git-ish commands. Fail-open on
# any error (never blocks non-git Bash). SI-1: CLI invoked as a file via stdin.
if [ "$TOOL_NAME" = "Bash" ]; then
  GIT_BASH_CMD=$(printf '%s' "$INPUT" | python3 -c "
import json, sys
d = json.load(sys.stdin)
print(d.get('tool_input', {}).get('command', ''))
" 2>/dev/null || echo "")
  case "$GIT_BASH_CMD" in
    *"git push"*|*"gh pr merge"*|*"git commit"*)
      GITGUARD_OUT=$(printf '%s' "$INPUT" | (cd "${CWD:-$PWD}" && node "${PLUGIN_ROOT}/scripts/lib/git-op-guard-cli.mjs") 2>/dev/null || echo "")
      GITGUARD_DECISION=$(printf '%s' "$GITGUARD_OUT" | python3 -c "
import json, sys
try: print(json.load(sys.stdin).get('decision', ''))
except: print('')
" 2>/dev/null || echo "")
      if [ "$GITGUARD_DECISION" = "deny" ]; then
        GITGUARD_REASON=$(printf '%s' "$GITGUARD_OUT" | python3 -c "
import json, sys
try:
    reason = json.load(sys.stdin).get('reason', 'git op bloqueada na branch protegida')
except:
    reason = 'git op bloqueada na branch protegida'
print(f'[devflow git-guard] {reason}')
" 2>/dev/null || echo "git op bloqueada na branch protegida")
        emit_decision deny "$GITGUARD_REASON"
        exit 0
      fi
      ;;
  esac
fi

# --- Only act on Edit and Write (legacy branch-protection logic) ---

if [ "$TOOL_NAME" != "Edit" ] && [ "$TOOL_NAME" != "Write" ]; then
  exit 0
fi

# --- Extract file path ---

FILE_PATH=$(printf '%s' "$INPUT" | python3 -c "
import json, sys
d = json.load(sys.stdin)
ti = d.get('tool_input', {})
print(ti.get('file_path', ti.get('file', '')))
" 2>/dev/null || echo "")

# --- Contexto pré-edição (normas + knowledge), emoldurado e com orçamento (T9) ---
# Vai para ADDL_CTX (NUNCA stdout cru). Roda antes dos checks de branch protection para
# que o contexto chegue mesmo quando o hook depois nega/pergunta: emit_decision anexa
# ADDL_CTX como additionalContext, e o trap flush_context o entrega nos caminhos de allow
# (marcando os ids no cache da sessão/agente). A 1ª linha do CLI são os ids; o resto, o
# texto. SESSION_KEY = session_id:agent_id (agent_id vazio no agente principal). SI-1: o
# CLI é arquivo com args. || true: nunca bloqueia.
PROJECT_ROOT="${CWD:-$PWD}"
if [ -n "$FILE_PATH" ]; then
  SESSION_KEY=$(printf '%s' "$INPUT" | python3 -c '
import json, sys
d = json.load(sys.stdin)
key = str(d.get("session_id") or "") + ":" + str(d.get("agent_id") or "")
print(key.replace("\n", " ").replace("\r", " "))
' 2>/dev/null || echo ":")
  PRE_EDIT_OUT=$(node "${PLUGIN_ROOT}/scripts/lib/pre-edit-context.mjs" "${PROJECT_ROOT}" "${FILE_PATH}" "${SESSION_KEY}" 2>/dev/null || true)
  if [ -n "$PRE_EDIT_OUT" ] && [ "${PRE_EDIT_OUT#*$'\n'}" != "$PRE_EDIT_OUT" ]; then
    ADDL_IDS="${PRE_EDIT_OUT%%$'\n'*}"
    ADDL_CTX="${PRE_EDIT_OUT#*$'\n'}"
  fi
fi

# --- Guard da catraca de standards (ADR-015 D6/D8) ---
# O CLI compara o enforcement efetivo antes/depois com o parser do loader e classifica pelo
# caminho e pelo realpath. deny (baseline) sai já; ask fica pendente e é emitido na saída
# (flush_context), para que um deny posterior (branch protegida, config-guard) prevaleça.
# Falha do CLI (saída vazia ou estranha): fallback pelo texto do caminho — baseline → deny,
# outro arquivo da catraca → ask, resto segue (D4: o hook só falha aberto fora da catraca).
# SI-1: CLI é arquivo com stdin. A razão vem crua e sai por emit_decision.
if [ -n "$FILE_PATH" ]; then
  STDGUARD_OUT=$(printf '%s' "$INPUT" | node "${PLUGIN_ROOT}/scripts/lib/standards-guard-cli.mjs" 2>/dev/null || true)
  case "$STDGUARD_OUT" in
    '{"decision":"",'*) ;;
    '{"decision":"deny",'*|'{"decision":"ask",'*)
      STDGUARD_REASON=$(printf '%s' "$STDGUARD_OUT" | python3 -c 'import json, sys
try: print(json.load(sys.stdin).get("reason") or "")
except Exception: print("")' 2>/dev/null || true)
      [ -n "$STDGUARD_REASON" ] || STDGUARD_REASON="[devflow standards] Edição de arquivo da catraca de standards: exige confirmação do operador (ADR-015 D6)."
      case "$STDGUARD_OUT" in
        '{"decision":"deny",'*) emit_decision deny "$STDGUARD_REASON" ;;
        *) STDGUARD_PENDING="$STDGUARD_REASON" ;;
      esac
      ;;
    *)
      shopt -s nocasematch
      case "$FILE_PATH" in
        *.context*standards*baseline.json*)
          emit_decision deny "[devflow standards] O baseline é da autoridade humana (ADR-015 D6) e o guard da catraca falhou: o agente não o edita." ;;
        *.context*standards*|*.context*devflow.yaml*|*devflow-standards.mjs*)
          STDGUARD_PENDING="[devflow standards] O guard da catraca falhou ao avaliar a edição de um arquivo da catraca: exige confirmação do operador (ADR-015 D6)." ;;
      esac
      shopt -u nocasematch
      ;;
  esac
fi

# --- Allow workflow/infrastructure files on any branch ---
# These are operational files, not project code.

if [ -n "$FILE_PATH" ]; then
  case "$FILE_PATH" in
    # Handoff and checkpoint files
    */.context/workflow/.checkpoint/*)
      exit 0
      ;;
    # Workflow state files
    */.context/workflow/*)
      exit 0
      ;;
    # Plans (PREVC workflow plans)
    */.context/plans/*)
      exit 0
      ;;
    # Context docs (sync updates these)
    */.context/docs/*)
      exit 0
      ;;
    # Context agents and skills (sync/init updates these)
    */.context/agents/*)
      exit 0
      ;;
    */.context/skills/*)
      exit 0
      ;;
    # Design specs and superpowers plans
    */docs/superpowers/*)
      exit 0
      ;;
    */docs/specs/*)
      exit 0
      ;;
    # DevFlow config file (config skill needs to write this)
    # ADV-8/B9: the config skill may legitimately edit this, but weakening the
    # git.* protection fields (branchProtection, protectedBranches, strategy) on a
    # protected branch is denied — auto-disarm must be escalated to the operator.
    # Non-weakening edits (and any edit on a work branch) still pass through.
    */.context/.devflow.yaml)
      CFGGUARD_OUT=$(printf '%s' "$INPUT" | (cd "${CWD:-$PWD}" && node "${PLUGIN_ROOT}/scripts/lib/devflow-config-guard-cli.mjs") 2>/dev/null || echo "")
      CFGGUARD_DECISION=$(printf '%s' "$CFGGUARD_OUT" | python3 -c "
import json, sys
try: print(json.load(sys.stdin).get('decision', ''))
except: print('')
" 2>/dev/null || echo "")
      if [ "$CFGGUARD_DECISION" = "deny" ]; then
        CFGGUARD_REASON=$(printf '%s' "$CFGGUARD_OUT" | python3 -c "
import json, sys
try:
    reason = json.load(sys.stdin).get('reason', '.devflow.yaml enfraquece a proteção git')
except:
    reason = '.devflow.yaml enfraquece a proteção git'
print(f'[devflow config-guard] {reason}')
" 2>/dev/null || echo ".devflow.yaml enfraquece a proteção git")
        emit_decision deny "$CFGGUARD_REASON"
        exit 0
      fi
      exit 0
      ;;
  esac
fi

# --- Get current branch ---

if [ -n "$CWD" ]; then
  BRANCH=$(git -C "$CWD" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
else
  BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
fi

# If we can't determine branch, allow (don't block on git errors)
if [ -z "$BRANCH" ]; then
  exit 0
fi

# --- Non-project paths (auto-memory, napkin) ---
# These are NOT project source code: auto-memory lives outside the repo
# (~/.claude/projects/*/memory/*) and the curated napkin is operational
# (.context/napkin.md). They must never be hard-denied by the branch gate —
# at most they get an ASK so the user confirms (avoids silent changes).
# MemPalace is reached via its MCP server (mcp__mempalace__*), not Edit/Write,
# so it is never intercepted by this hook.
is_nonproject_path() {
  case "$1" in
    */.claude/projects/*/memory/*|*/.context/napkin.md) return 0 ;;
    *) return 1 ;;
  esac
}

emit_ask_nonproject() {
  local msg
  msg="$(render_msg "$MSG_ASK_HEADER" "file_path=${1}" "branch=${2}")"
  # Ask pendente da catraca (T16): o caminho de memória/napkin pode ser um link para um
  # arquivo da catraca — as duas razões chegam ao operador.
  if [ -n "$STDGUARD_PENDING" ]; then msg="${msg}
${STDGUARD_PENDING}"; fi
  emit_decision ask "$msg"
}

# --- Also check: is the file being edited inside the plugin itself? ---

PLUGIN_ROOT_CHECK="${CLAUDE_PLUGIN_ROOT:-}"
if [ -n "$PLUGIN_ROOT_CHECK" ] && [ -n "$FILE_PATH" ]; then
  case "$FILE_PATH" in
    "$PLUGIN_ROOT_CHECK"*)
      exit 0
      ;;
  esac
fi

# --- Read .context/.devflow.yaml ---
# Resolve the project root with the same ${CWD:-$PWD} fallback used by the
# permissions (L46), grounding (L115) and project-root (L178) blocks, and by the
# branch-detection block below (L227-231). When the harness omits cwd in the
# PreToolUse event, $CWD is empty and the hook's own $PWD is the project root —
# so the config is still located. Without this fallback the gate wrongly concludes
# "no config" and denies every project edit even on a non-protected branch.

DEVFLOW_CONFIG="${CWD:-$PWD}/.context/.devflow.yaml"

# If no config exists → DENY with config instruction.
# EXCEPTION: non-project files (auto-memory, napkin) are never hard-denied,
# even when cwd/config is unavailable (e.g. cwd arrives empty for a Write
# outside the workspace). Emit ASK so the user still confirms.
if [ -z "$DEVFLOW_CONFIG" ] || [ ! -f "$DEVFLOW_CONFIG" ]; then
  if is_nonproject_path "$FILE_PATH"; then
    emit_ask_nonproject "$FILE_PATH" "$BRANCH"
    exit 0
  fi
  emit_decision deny "$MSG_NO_CONFIG"
  exit 0
fi

# --- Parse git config from YAML ---

read_yaml_field() {
  local file="$1" field="$2"
  python3 - "$file" "$field" << 'PYEOF'
import sys
file_path, field_name = sys.argv[1], sys.argv[2]
try:
    import yaml
    with open(file_path) as f:
        data = yaml.safe_load(f)
    git = data.get('git', {})
    val = git.get(field_name, '')
    if isinstance(val, list):
        print(' '.join(str(v) for v in val))
    elif isinstance(val, bool):
        print(str(val).lower())
    elif isinstance(val, dict):
        import json
        print(json.dumps(val))
    else:
        print(str(val))
except ImportError:
    # Fallback: line-by-line parse for simple YAML (no PyYAML).
    # Handles scalar values and [list] syntax. Does NOT handle nested dicts.
    import re
    in_git = False
    for line in open(file_path):
        stripped = line.strip()
        if stripped == 'git:':
            in_git = True
            continue
        if in_git and not line.startswith(' ') and not line.startswith('\t') and stripped:
            break
        if in_git and field_name + ':' in stripped:
            match = re.match(r'\s*' + re.escape(field_name) + r':\s*(.*)', stripped)
            if match:
                val = match.group(1).strip()
                if val.startswith('[') and val.endswith(']'):
                    val = val[1:-1].replace(',', ' ').replace('"', '').replace("'", '')
                print(val)
                break
    else:
        # for/else: prints empty when field not found (loop completed without break)
        print('')
PYEOF
}

GIT_STRATEGY=$(read_yaml_field "$DEVFLOW_CONFIG" "strategy")
BRANCH_PROTECTION=$(read_yaml_field "$DEVFLOW_CONFIG" "branchProtection")
PROTECTED_BRANCHES=$(read_yaml_field "$DEVFLOW_CONFIG" "protectedBranches")

# --- Apply strategy rules ---

# trunk-based: no protection, allow everything
if [ "$GIT_STRATEGY" = "trunk-based" ]; then
  exit 0
fi

# branchProtection explicitly disabled
if [ "$BRANCH_PROTECTION" = "false" ]; then
  exit 0
fi

# --- Check if current branch is protected ---

IS_PROTECTED=false
for pb in $PROTECTED_BRANCHES; do
  if [ "$BRANCH" = "$pb" ]; then
    IS_PROTECTED=true
    break
  fi
done

if [ "$IS_PROTECTED" = "false" ]; then
  exit 0
fi

# --- ASK: on protected branch, editing confirmable paths (memory/napkin) ---
# Non-project files: auto-memory (outside the repo) and curated napkin (inside .context/).
# Emite ask: o Claude Code pede confirmação por edição.

if [ -n "$FILE_PATH" ] && is_nonproject_path "$FILE_PATH"; then
  emit_ask_nonproject "$FILE_PATH" "$BRANCH"
  exit 0
fi

# --- BLOCK: on protected branch, editing project source code ---

blocked_header=$(render_msg "$MSG_BLOCKED_HEADER" "branch=${BRANCH}")
blocked_file=$(render_msg "$MSG_BLOCKED_FILE" "file_path=${FILE_PATH}")

REASON="${blocked_header}

${MSG_BLOCKED_ACTION}

${blocked_file}

${MSG_BLOCKED_NOTE}"

emit_decision deny "$REASON"

exit 0
